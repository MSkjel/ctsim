	TrendWin("a", 1, 1, 1);
	TrendWin("a", 1, 1, 1, "a", "a", "a", "a", "a", "a", "a", "a");
	TrendZoom(1, 1.5, 1.5);
	TrendZoom(1, 1.5, 1.5, 1);
END
