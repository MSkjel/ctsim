	TrnExportDBF("a", 1, 1.5, 1, 1);
	TrnExportDBF("a", 1, 1.5, 1, 1, "a", "a", "a", "a", "a", "a", "a", "a", 1, 1, 1, 1, 1, 1, 1, 1);
	TrnExportDDE("a", "a", "a", 1, 1.5, 1, 1, 1);
	TrnExportDDE("a", "a", "a", 1, 1.5, 1, 1, 1, "a", "a", "a", "a", "a", "a", "a", "a", 1, 1, 1, 1, 1, 1, 1, 1);
	TrnFlush("a");
