INT FUNCTION QCb()
	RETURN 0;
END
FUNCTION P()
	INT vi = 1;
	REAL vr = 1;
	STRING vs = "a";
	OBJECT vo;
	TIMESTAMP vt;
	QUALITY vq;
	SQLParamsSetAsString(1, "a", "a");
	SQLParamsSetAsString(1, "a", "a", 1);
	SQLTraceOff();
	SQLTraceOff(1);
	SQLTraceOn();
	SQLTraceOn("a", 1, 1);
	StrCalcWidth("a");
	StrCalcWidth("a", 1);
	StrListContainsItem("a", "a");
	StrListContainsItem("a", "a", "a");
	StrReplace("a", "a");
	StrReplace("a", "a", "a", "a");
	StrSplit("a");
	StrSplit("a", "a", 1);
	StrToTimestamp("a");
	StrToTimestamp("a", 1, 1);
	StrTruncFont("a", "a");
	StrTruncFont("a", "a", 1, 1);
	StrTruncFontHnd("a", 1);
	StrTruncFontHnd("a", 1, 1, 1);
END
