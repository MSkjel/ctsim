	QUALITY vq;
	AccControl("a", 1);
	AccControl("a", 1, "a");
	AccumBrowseOpen("a", "a");
	AccumBrowseOpen("a", "a", "a");
	AlarmAck(1, 1);
	AlarmAck(1, 1, "a");
