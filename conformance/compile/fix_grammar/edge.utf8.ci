STRING FUNCTION Fmt(INT i, REAL r)
	STRING s;
	s = i:####;
	s = r:###.##;
	s = i:#0##;
	s = i:#-###;
	s = r:####.##EU;
	s = r:####.## EU;
	s = r:#s###;
	s = r:#0-###.##EU;
	s = r:###engunit;
	s = r:#.;
	s = r:###.#eu;
	s = r:###s;
	s = i:5;
	s = r:3.2;
	s = i:-5;
	s = r:-5.2;
	s = i: - 5;
	s = i:~;
	s = i : ####;
	s = i:
	####;
	s = i: /* c */ ###;
	s = i:0x5;
	s = i:0b11;
	s = r:6.0EU;
	s = i:0###;
	s = i:###! code after bang;
	s = "a" + i:###;
	s = r:###.##EUnits;
	RETURN s;
END

