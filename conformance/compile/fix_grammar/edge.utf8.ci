// edge cases from lexical.md
INT FUNCTION P()
	INT i;
	/*/ still inside ZzHidden1 */
	/**/ i = ZzVisible1;
	/* ends with double star **/ i = ZzVisible2;
	/*** triple ***/ i = ZzVisible3;
	/** doc @param x text */ i = ZzVisible4;
	i = 1;! comment
	i = 2! comment
	;
	i = 4/2 //2
	i = 1 /* x */ + 2 + 1/**/+2;
	RETURN i;
END

REAL FUNCTION Nums()
	REAL v;
	v = 1. + 1e3 + 1E+3 + 1.5e-3 + 1.e5 + 2.5E2 + 1e + 1e400 + 1e+;
	v = 0x1F + 0X1f + 0xFFFFFFFF + 0x0000000001 + 0x;
	v = 0b101 + 0B11 + 0b + 0o17 + 0O7 + 017 + 09;
	v = 4294967295 + 00004294967295;
	v = 0x100000000 + 0xFFFFFFFFFFFFFFFF + 4294967296 + 99999999999 + 0o40000000000 + 0b111111111111111111111111111111111;
	v = 0b011111111111111111111111111111111 + 0o37777777777;
	v = 5x10 + 12b + 0FFh + 1ex + 1.5Zz + 0x1FZz + 1.Zz;
	v = 1AND 2;
	RETURN v;
END

