INT FUNCTION Ops(INT a, INT b)
	IF a <> b AND a <= b OR a >= b THEN a = a MOD b; END
	IF NOT a = b THEN a = a BITAND b BITOR 1 BITXOR 2; END
	a = a == b;
	a = a % b;
	a = a && b || c;
	a = ~b ^ 2;
	a = 'x';
	a = XOR;
	a = Tag.Field + A.B.C;
	RETURN a;
END

FUNCTION Blocks()
	INT i;
	IF i THEN i = 1; ELSE IF i = 2 THEN i = 3; END END
	WHILE i < 10 DO i = i + 1; END
	FOR i = 1 TO 10 DO Sleep(1); END
	SELECT CASE i
	CASE 1, 2 TO 3, IS > 5
		i = 0;
	CASE ELSE
		IF i THEN i = 1; END
	END SELECT
	SELECT CASE i CASE 1 i = 2; CASE ELSE i = 3; END SELECT
	if i then i = 2 end
END

FUNCTION NoParens
	Sleep(1);
	RETURN;
END

